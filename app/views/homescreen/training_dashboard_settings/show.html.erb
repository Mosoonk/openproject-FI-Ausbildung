<% html_title t("home_dashboard.configure_types") %>

<%= render Primer::OpenProject::PageHeader.new do |header| %>
  <% header.with_title { t("home_dashboard.configure_types") } %>
  <% header.with_breadcrumbs([{ href: home_path, text: t(:label_home) }, t("home_dashboard.configure_types")]) %>
<% end %>

<%= styled_form_tag(training_dashboard_settings_path, method: :patch) do %>
  <section class="form--section" id="training-dashboard-settings">
    <fieldset class="form--fieldset">
      <legend class="form--fieldset-legend"><%= t("home_dashboard.title") %></legend>
      <p class="form--field-instructions"><%= t("home_dashboard.task_types_help") %></p>
      <div class="form--field">
        <%= setting_multiselect(
              :training_dashboard_task_type_ids,
              Homescreen::TrainingDashboardQuery.available_types.map { |type| [type.name, type.id.to_s] }
            ) %>
      </div>
    </fieldset>
  </section>
  <%= styled_button_tag t(:button_save), class: "-primary -with-icon icon-checkmark" %>
  <%= link_to t(:label_home), home_path %>
<% end %>
