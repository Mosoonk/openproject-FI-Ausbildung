# Copy this file to .env and keep .env outside Git.
OPENPROJECT_IMAGE=openproject-daily-report:17.8.0-dr.1-candidate

# IP address and port used by browsers. Include the port unless it is 80.
OPENPROJECT_HOST__NAME=192.0.2.10:8080
BIND_IP=0.0.0.0
HTTP_PORT=8080

# Generate separate values; never commit the resulting .env file.
# Password must be URL-encoded in DATABASE_URL if it contains reserved URL characters.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://openproject:replace-with-the-same-url-encoded-password@db:5432/openproject?pool=20
SECRET_KEY_BASE=replace-with-at-least-64-random-hex-characters
